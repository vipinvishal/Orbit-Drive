# Postgres connection (Supabase free tier, or local Postgres for dev).
# Must use the asyncpg driver — asyncpg is what the app connects with at runtime;
# Alembic migrations swap this to psycopg2 automatically (see alembic/env.py).
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# JWT session signing.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Fernet key used to encrypt Google OAuth tokens at rest.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Google Cloud OAuth client (Web application type), drive.file scope only — see mvp.md §5.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/accounts/google/callback

# Where the frontend runs — used for CORS and for the post-OAuth redirect.
FRONTEND_URL=http://localhost:3000
